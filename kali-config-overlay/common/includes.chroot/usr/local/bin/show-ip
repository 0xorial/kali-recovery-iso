#!/bin/sh
# Show how to reach this machine over SSH, once DHCP has handed out an address.
for i in $(seq 1 30); do
    IPS=$(ip -4 -o addr show scope global | awk '{print $2": "$4}')
    [ -n "$IPS" ] && break
    sleep 2
done
zenity --info --title "SSH access" --width 360 \
    --text "ssh kali@$(hostname).local\n\n${IPS:-No IPv4 address yet (check cable/Wi-Fi)}" 2>/dev/null || true
